---
import AWork from './AWork.astro'

import pen4 from '../assets/works/Pen-4.mp4'
import pen5 from '../assets/works/Pen-5.mp4'
import pen6 from '../assets/works/Pen-6.mp4'
import pen7 from '../assets/works/Pen-7.mp4'
import pen8 from '../assets/works/Pen-8.mp4'
import dummy from '../assets/works/Dummy.mp4'

// Placeholder content. Real works drop in here later — one object per
// panel, nothing else in the codebase needs to change.
const WORKS = [
  {
    title: 'Northbound',
    year: '2025',
    role: 'Design & development',
    tags: ['Branding', 'Web'],
    video: pen4,
    href: 'https://example.com/northbound',
  },
  {
    title: 'Halide',
    year: '2024',
    role: 'Art direction',
    tags: ['Motion', 'Identity'],
    video: pen5,
    href: 'https://example.com/halide',
  },
  {
    title: 'Quietwork',
    year: '2024',
    role: 'Design & development',
    tags: ['Product', 'Web'],
    video: pen6,
    href: 'https://example.com/quietwork',
  },
  {
    title: 'Marrow',
    year: '2023',
    role: 'Creative direction',
    tags: ['Film', 'Web'],
    video: pen7,
    href: 'https://example.com/marrow',
  },
  {
    title: 'Overtone',
    year: '2023',
    role: 'Design & development',
    tags: ['Audio', 'Product'],
    video: pen8,
    href: 'https://example.com/overtone',
  },
  {
    title: 'Fieldnote',
    year: '2022',
    role: 'Design & development',
    tags: ['Editorial', 'Web'],
    video: dummy,
    href: 'https://example.com/fieldnote',
  },
]

const total = String(WORKS.length).padStart(2, '0')
---

<section id="work" class="s-work">
  <div class="s__stack js-stack">
    {
      WORKS.map((work, i) => (
        <div class="s__panel js-panel" style={`z-index:${i + 1}`}>
          <div class="s__panel__inner js-panel-inner">
            <div class="s__panel__media">
              <AWork src={work.video} className="s__panel__video js-panel-video" />
            </div>

            <div class="s__panel__meta">
              <span class="s__panel__index">
                {String(i + 1).padStart(2, '0')} / {total}
              </span>
              <span class="s__panel__role">{work.role}</span>
              <span class="s__panel__tags">{work.tags.join(' / ')}</span>
            </div>

            <div class="s__panel__foot">
              <h3 class="s__panel__title">{work.title}</h3>
              <a class="s__panel__link" href={work.href} target="_blank" rel="noopener">
                {work.year} — view project
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  interface AWorkElement extends HTMLElement {
    activate: () => void
    deactivate: () => void
  }

  const panels = Array.from(document.querySelectorAll<HTMLElement>('.js-panel'))

  /**
   * Play/pause each panel's video purely based on viewport visibility —
   * independent from the scroll-driven scale/dim below.
   */
  const visibilityObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const panel = entry.target as HTMLElement
        const aWork = panel.querySelector<AWorkElement>('a-work')

        if (entry.isIntersecting) {
          aWork?.activate()
        } else {
          aWork?.deactivate()
        }
      })
    },
    { threshold: 0.5 }
  )

  panels.forEach((panel) => visibilityObserver.observe(panel))

  /**
   * As each panel is covered by the next one sliding over it, scrub its
   * own inner container down to scale(0.96) / opacity 0.6.
   */
  panels.forEach((panel, i) => {
    const nextPanel = panels[i + 1]
    if (!nextPanel) return

    const inner = panel.querySelector<HTMLElement>('.js-panel-inner')
    if (!inner) return

    gsap.fromTo(
      inner,
      { scale: 1, opacity: 1 },
      {
        scale: 0.96,
        opacity: 0.6,
        ease: 'none',
        scrollTrigger: {
          trigger: nextPanel,
          start: 'top bottom',
          end: 'top top',
          scrub: true,
        },
      }
    )
  })
</script>

<style lang="scss">
  .s-work {
    position: relative;

    background: color(secondary);
    color: color(primary);
  }

  .s__stack {
    position: relative;
  }

  .s__panel {
    position: sticky;
    top: 0;

    height: 100svh;

    overflow: hidden;
  }

  .s__panel__inner {
    position: relative;

    width: 100%;
    height: 100%;

    border-top: 1px solid color-mix(in srgb, color(primary) 25%, transparent);

    will-change: transform, opacity;
  }

  .s__panel__media {
    position: absolute;
    inset: 0;

    background: color(secondary);
  }

  :global(.s__panel__video) {
    opacity: 0.55;
  }

  .s__panel__meta {
    position: absolute;
    top: 2rem;
    right: 2rem;
    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;

    text-align: right;

    font: 400 0.75rem / 1.4 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;

    @include mq(phone) {
      top: 1.25rem;
      right: 1.25rem;
    }
  }

  .s__panel__tags {
    opacity: 0.6;
  }

  .s__panel__foot {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    z-index: 2;

    max-width: 80%;

    @include mq(phone) {
      left: 1.25rem;
      bottom: 1.5rem;
      max-width: 100%;
    }
  }

  .s__panel__title {
    margin: 0 0 0.75rem;

    font: 200 clamp(2.75rem, 8vw, 8rem) / 0.95 font-family(editorial);
    letter-spacing: -0.01em;
  }

  .s__panel__link {
    display: inline-block;

    padding-top: 0.5rem;

    border-top: 1px solid color-mix(in srgb, color(primary) 40%, transparent);

    color: color(primary);
    font: 400 0.8rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
</style>
