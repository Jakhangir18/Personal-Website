---
import AWork from './AWork.astro'

import pen4 from '../assets/works/Pen-4.mp4'
import pen5 from '../assets/works/Pen-5.mp4'
import pen6 from '../assets/works/Pen-6.mp4'
import pen7 from '../assets/works/Pen-7.mp4'
import pen8 from '../assets/works/Pen-8.mp4'
import dummy from '../assets/works/Dummy.mp4'

// Placeholder content. Real works drop in here later — one object per row,
// nothing else in the codebase needs to change.
const WORKS = [
  {
    title: 'Northbound',
    year: '2025',
    role: 'Design & development',
    tags: ['Branding', 'Web'],
    video: pen4,
    href: 'https://example.com/northbound',
  },
  {
    title: 'Halide',
    year: '2024',
    role: 'Art direction',
    tags: ['Motion', 'Identity'],
    video: pen5,
    href: 'https://example.com/halide',
  },
  {
    title: 'Quietwork',
    year: '2024',
    role: 'Design & development',
    tags: ['Product', 'Web'],
    video: pen6,
    href: 'https://example.com/quietwork',
  },
  {
    title: 'Marrow',
    year: '2023',
    role: 'Creative direction',
    tags: ['Film', 'Web'],
    video: pen7,
    href: 'https://example.com/marrow',
  },
  {
    title: 'Overtone',
    year: '2023',
    role: 'Design & development',
    tags: ['Audio', 'Product'],
    video: pen8,
    href: 'https://example.com/overtone',
  },
  {
    title: 'Fieldnote',
    year: '2022',
    role: 'Design & development',
    tags: ['Editorial', 'Web'],
    video: dummy,
    href: 'https://example.com/fieldnote',
  },
]

const total = String(WORKS.length).padStart(2, '0')
---

<section id="work" class="s-work">
  <div class="s__head">
    <span class="s__head__eyebrow">Selected work</span>
    <span class="s__head__count">{total}</span>
  </div>

  <div class="s__list js-list">
    {
      WORKS.map((work, i) => (
        <div
          class="s__row js-row"
          data-work={JSON.stringify({ title: work.title, video: work.video })}
          tabindex="0"
        >
          <span class="s__row__index">{String(i + 1).padStart(2, '0')}</span>

          <a class="s__row__title" href={work.href} target="_blank" rel="noopener">
            {work.title}
          </a>

          <div class="s__row__meta">
            <span class="s__row__year">{work.year}</span>
            <span class="s__row__role">{work.role}</span>
            <span class="s__row__tags">{work.tags.join(' / ')}</span>
          </div>

          <div class="s__row__mobile-preview js-mobile-preview">
            <div class="s__row__mobile-preview__inner">
              <AWork src={work.video} className="s__row__mobile-video js-mobile-video" />
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="s__float js-float" aria-hidden="true">
    <div class="s__float__inner">
      <video class="s__float__video js-float-video" muted playsinline loop preload="none"></video>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  interface AWorkElement extends HTMLElement {
    activate: () => void
    deactivate: () => void
  }

  interface RowData {
    title: string
    video: string
  }

  const list = document.querySelector<HTMLElement>('.js-list')
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.js-row'))
  const floatEl = document.querySelector<HTMLElement>('.js-float')
  const floatVideo = document.querySelector<HTMLVideoElement>('.js-float-video')

  /**
   * Entrance animation — each row fades/slides in once as it reaches the
   * viewport. No scrub, no repeat.
   */
  rows.forEach((row) => {
    gsap.fromTo(
      row,
      { opacity: 0, y: 28 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: row,
          start: 'top 92%',
          once: true,
        },
      }
    )
  })

  /**
   * Desktop: a single floating preview follows the cursor while hovering
   * (or focusing) a row. Only one video element exists — its source is
   * swapped per-row instead of mounting one video per row.
   */
  if (list && floatEl && floatVideo) {
    let activeRow: HTMLElement | null = null
    let pointerX = 0
    let pointerY = 0
    let floatX = 0
    let floatY = 0
    let rafId: number | null = null

    const readWork = (row: HTMLElement): RowData | null => {
      const raw = row.dataset.work
      if (!raw) return null
      try {
        return JSON.parse(raw) as RowData
      } catch {
        return null
      }
    }

    const setFloatSrc = (video: string) => {
      if (floatVideo.dataset.current === video) return
      floatVideo.dataset.current = video
      floatVideo.src = video
      floatVideo.load()
    }

    const loop = () => {
      floatX += (pointerX - floatX) * 0.2
      floatY += (pointerY - floatY) * 0.2

      const rect = floatEl.getBoundingClientRect()
      const x = Math.min(Math.max(floatX + 28, 16), window.innerWidth - rect.width - 16)
      const y = Math.min(Math.max(floatY - rect.height / 2, 16), window.innerHeight - rect.height - 16)

      floatEl.style.transform = `translate3d(${x}px, ${y}px, 0)`

      rafId = requestAnimationFrame(loop)
    }

    const startLoop = () => {
      if (rafId === null) rafId = requestAnimationFrame(loop)
    }

    const stopLoop = () => {
      if (rafId !== null) cancelAnimationFrame(rafId)
      rafId = null
    }

    const show = (row: HTMLElement) => {
      const work = readWork(row)
      if (!work) return

      activeRow = row
      setFloatSrc(work.video)
      floatVideo.play().catch(() => {})
      floatEl.classList.add('is-visible')
      startLoop()
    }

    const hide = () => {
      activeRow = null
      floatEl.classList.remove('is-visible')
      floatVideo.pause()
      stopLoop()
    }

    rows.forEach((row) => {
      row.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return
        pointerX = event.clientX
        pointerY = event.clientY
        show(row)
      })

      row.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return
        pointerX = event.clientX
        pointerY = event.clientY
      })

      row.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'touch') return
        if (activeRow === row) hide()
      })

      row.addEventListener('focus', () => {
        const rect = row.getBoundingClientRect()
        pointerX = rect.left + rect.width * 0.5
        pointerY = rect.top + rect.height * 0.5
        floatX = pointerX
        floatY = pointerY
        show(row)
      })

      row.addEventListener('blur', () => {
        if (activeRow === row) hide()
      })
    })
  }

  /**
   * Mobile: no cursor, so the row expands inline and plays its own preview
   * once it is centred in the viewport.
   */
  const mq = window.matchMedia('(max-width: 767px)')
  let centerObserver: IntersectionObserver | null = null

  const teardownCenterObserver = () => {
    centerObserver?.disconnect()
    centerObserver = null

    rows.forEach((row) => {
      row.classList.remove('is-active')
      const aWork = row.querySelector<AWorkElement>('a-work')
      aWork?.deactivate()
    })
  }

  const setupCenterObserver = () => {
    if (centerObserver) return

    centerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const row = entry.target as HTMLElement
          const aWork = row.querySelector<AWorkElement>('a-work')

          if (entry.isIntersecting) {
            row.classList.add('is-active')
            aWork?.activate()
          } else {
            row.classList.remove('is-active')
            aWork?.deactivate()
          }
        })
      },
      { threshold: 0, rootMargin: '-42% 0px -42% 0px' }
    )

    rows.forEach((row) => centerObserver?.observe(row))
  }

  const syncForViewport = () => {
    if (mq.matches) {
      setupCenterObserver()
    } else {
      teardownCenterObserver()
    }
  }

  syncForViewport()
  mq.addEventListener('change', syncForViewport)
</script>

<style lang="scss">
  .s-work {
    position: relative;

    padding: 12rem 1.5rem 8rem;

    background: color(secondary);
    color: color(primary);

    @include mq(phone) {
      padding: 6rem 1.25rem 4rem;
    }
  }

  .s__head {
    @include flex(row, baseline, space-between);

    margin-bottom: 4rem;
    padding-bottom: 1rem;

    border-bottom: 1px solid color-mix(in srgb, color(primary) 30%, transparent);
  }

  .s__head__eyebrow {
    font: 400 0.8rem / 1 font-family(fraktion);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .s__head__count {
    font: 400 0.8rem / 1 font-family(fraktion);
    letter-spacing: 0.18em;
    opacity: 0.6;
  }

  .s__list {
    display: block;
  }

  .s__row {
    position: relative;

    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: baseline;
    column-gap: 1.5rem;

    padding: 2.25rem 0;

    border-bottom: 1px solid color-mix(in srgb, color(primary) 15%, transparent);

    cursor: pointer;

    @include mq(phone) {
      grid-template-columns: 2.25rem 1fr;
      row-gap: 0.75rem;
      padding: 1.75rem 0;
    }
  }

  .s__row__index {
    font: 400 0.85rem / 1 font-family(fraktion);
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .s__row__title {
    display: block;

    font: 200 clamp(2.5rem, 7vw, 7rem) / 0.98 font-family(editorial);
    letter-spacing: -0.01em;

    color: color(primary);
    text-decoration: none;

    transition: opacity 0.3s ease;

    .s__row:hover &,
    .s__row:focus-visible &,
    .s__row.is-active & {
      opacity: 0.55;
    }
  }

  .s__row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;

    text-align: right;

    font: 400 0.75rem / 1.4 font-family(fraktion);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.65;

    @include mq(phone) {
      grid-column: 2;
      align-items: flex-start;
      text-align: left;
    }
  }

  .s__row__mobile-preview {
    display: none;

    grid-column: 1 / -1;

    @include mq(phone) {
      display: grid;
      grid-template-rows: 0fr;

      transition: grid-template-rows 0.45s ease;
    }

    &__inner {
      overflow: hidden;
    }
  }

  .s__row.is-active .s__row__mobile-preview {
    @include mq(phone) {
      grid-template-rows: 1fr;
    }
  }

  :global(.s__row__mobile-video) {
    aspect-ratio: 16 / 10;

    margin-top: 0.75rem;

    background: color-mix(in srgb, color(primary) 6%, transparent);
  }

  .s__float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;

    width: min(32vw, 26rem);
    aspect-ratio: 16 / 10;

    opacity: 0;
    pointer-events: none;

    transition: opacity 0.25s ease;

    will-change: transform;

    @include mq(tablet) {
      display: none;
    }

    &.is-visible {
      opacity: 1;
    }
  }

  .s__float__inner {
    width: 100%;
    height: 100%;

    background: color(secondary);
    outline: 1px solid color-mix(in srgb, color(primary) 30%, transparent);
  }

  .s__float__video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }
</style>
