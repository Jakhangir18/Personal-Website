---
import AWork from './AWork.astro'

import pen4 from '../assets/works/Pen-4.mp4'
import pen5 from '../assets/works/Pen-5.mp4'
import pen6 from '../assets/works/Pen-6.mp4'
import pen7 from '../assets/works/Pen-7.mp4'
import pen8 from '../assets/works/Pen-8.mp4'
import dummy from '../assets/works/Dummy.mp4'

// Placeholder content. Real works drop in here later — one object per
// tile, nothing else in the codebase needs to change.
const WORKS = [
  {
    title: 'Northbound',
    year: '2025',
    role: 'Design & development',
    tags: ['Branding', 'Web'],
    video: pen4,
    href: 'https://example.com/northbound',
  },
  {
    title: 'Halide',
    year: '2024',
    role: 'Art direction',
    tags: ['Motion', 'Identity'],
    video: pen5,
    href: 'https://example.com/halide',
  },
  {
    title: 'Quietwork',
    year: '2024',
    role: 'Design & development',
    tags: ['Product', 'Web'],
    video: pen6,
    href: 'https://example.com/quietwork',
  },
  {
    title: 'Marrow',
    year: '2023',
    role: 'Creative direction',
    tags: ['Film', 'Web'],
    video: pen7,
    href: 'https://example.com/marrow',
  },
  {
    title: 'Overtone',
    year: '2023',
    role: 'Design & development',
    tags: ['Audio', 'Product'],
    video: pen8,
    href: 'https://example.com/overtone',
  },
  {
    title: 'Fieldnote',
    year: '2022',
    role: 'Design & development',
    tags: ['Editorial', 'Web'],
    video: dummy,
    href: 'https://example.com/fieldnote',
  },
]

// Duplicated once so the mobile CSS marquee (translateX 0 -> -50%) loops
// seamlessly; the desktop scrub just needs enough width to travel.
const tickerUnit = WORKS.map((work) => work.title).join('   —   ') + '   —   '
const tickerText = tickerUnit + tickerUnit
---

<section id="work" class="s-work">
  <div class="s__pin js-pin">
    <div class="s__head">
      <span class="s__head__eyebrow">Selected work</span>
      <span class="s__head__count">{String(WORKS.length).padStart(2, '0')}</span>
    </div>

    <div class="s__track-wrap js-track-wrap">
      <div class="s__track js-track">
        {
          WORKS.map((work, i) => (
            <a
              class="s__tile js-tile"
              href={work.href}
              target="_blank"
              rel="noopener"
            >
              <div class="s__tile__media">
                <AWork src={work.video} className="s__tile__video js-tile-video" />
              </div>

              <div class="s__tile__meta">
                <span class="s__tile__index">{String(i + 1).padStart(2, '0')}</span>
                <span class="s__tile__year">{work.year}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="s__ticker-wrap">
      <div class="s__ticker js-ticker">{tickerText}</div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  interface AWorkElement extends HTMLElement {
    activate: () => void
    deactivate: () => void
  }

  const pin = document.querySelector<HTMLElement>('.js-pin')
  const trackWrap = document.querySelector<HTMLElement>('.js-track-wrap')
  const track = document.querySelector<HTMLElement>('.js-track')
  const ticker = document.querySelector<HTMLElement>('.js-ticker')
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.js-tile'))

  /**
   * Play/pause each tile's video purely based on horizontal visibility —
   * works identically whether the strip is pinned+scrubbed (desktop) or
   * natively scrolled (mobile), since IntersectionObserver reads the real
   * rendered position either way.
   */
  const visibilityObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const tile = entry.target as HTMLElement
        const aWork = tile.querySelector<AWorkElement>('a-work')

        if (entry.isIntersecting) {
          aWork?.activate()
        } else {
          aWork?.deactivate()
        }
      })
    },
    { threshold: 0.4, rootMargin: '0px -10% 0px -10%' }
  )

  tiles.forEach((tile) => visibilityObserver.observe(tile))

  /**
   * Desktop: pin the section and scrub the filmstrip horizontally against
   * vertical scroll; the title ticker rides the same scrub at half the
   * travel distance. Mobile: no pin at all — native horizontal
   * scroll-snap takes over instead.
   */
  if (pin && trackWrap && track && ticker) {
    const mm = gsap.matchMedia()

    mm.add(
      {
        isDesktop: '(min-width: 768px)',
        isMobile: '(max-width: 767px)',
      },
      (context) => {
        const conditions = (context as gsap.Context & { conditions: { isDesktop: boolean } }).conditions

        if (conditions.isDesktop) {
          pin.classList.remove('is-native-scroll')

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: pin,
              start: 'top top',
              end: () => `+=${Math.max(track.scrollWidth - window.innerWidth, 0)}`,
              scrub: 1,
              pin: true,
              invalidateOnRefresh: true,
            },
          })

          tl.fromTo(
            track,
            { x: 0 },
            { x: () => -Math.max(track.scrollWidth - window.innerWidth, 0), ease: 'none' },
            0
          )

          tl.fromTo(
            ticker,
            { x: 0 },
            { x: () => -Math.max(track.scrollWidth - window.innerWidth, 0) * 0.5, ease: 'none' },
            0
          )
        } else {
          pin.classList.add('is-native-scroll')
        }

        return () => {
          gsap.set([track, ticker], { clearProps: 'transform' })
        }
      }
    )
  }
</script>

<style lang="scss">
  .s-work {
    position: relative;

    background: color(secondary);
    color: color(primary);
  }

  .s__pin {
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;

    height: 100svh;
    padding: 2rem 0;

    overflow: hidden;

    @include mq(phone) {
      height: auto;
      padding: 6rem 0 4rem;
    }
  }

  .s__head {
    @include flex(row, baseline, space-between);

    padding: 0 1.5rem;

    font: 400 0.8rem / 1 font-family(fraktion);
    letter-spacing: 0.18em;
    text-transform: uppercase;

    @include mq(phone) {
      padding: 0 1.25rem;
    }

    &__count {
      opacity: 0.6;
    }
  }

  .s__track-wrap {
    overflow: hidden;

    .s__pin.is-native-scroll & {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  .s__track {
    display: flex;
    gap: 1px;

    padding: 0 1.5rem;

    background: color-mix(in srgb, color(primary) 15%, transparent);

    will-change: transform;

    @include mq(phone) {
      padding: 0 1.25rem;
    }
  }

  .s__tile {
    position: relative;
    flex: 0 0 auto;

    display: block;
    width: min(72vw, 56rem);

    aspect-ratio: 16 / 10;

    background: color(secondary);
    text-decoration: none;

    scroll-snap-align: center;
  }

  .s__tile__media {
    position: absolute;
    inset: 0;
  }

  :global(.s__tile__video) {
    opacity: 0.7;
  }

  .s__tile__meta {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;

    display: flex;
    gap: 0.75rem;

    font: 400 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .s__tile__index {
    opacity: 0.9;
  }

  .s__tile__year {
    opacity: 0.55;
  }

  .s__ticker-wrap {
    overflow: hidden;

    padding: 1.5rem 0 0;

    border-top: 1px solid color-mix(in srgb, color(primary) 25%, transparent);
  }

  .s__ticker {
    display: inline-block;

    padding-left: 100%;

    white-space: nowrap;

    font: 200 clamp(2rem, 6vw, 5rem) / 1 font-family(editorial);
    letter-spacing: -0.01em;
    text-transform: uppercase;

    will-change: transform;

    .s__pin.is-native-scroll & {
      padding-left: 0;
      animation: s-ticker-marquee 22s linear infinite;
    }
  }

  @keyframes s-ticker-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
