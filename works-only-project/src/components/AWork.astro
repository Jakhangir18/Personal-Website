---
interface Props {
  src: string
  className?: string
}

const { src, className = '' } = Astro.props as Props
---

<a-work class={className}>
  <video
    class="a__video js-video"
    data-src={src}
    muted
    playsinline
    loop
    preload="none"
  ></video>
</a-work>

<script>
  class AWork extends HTMLElement {
    video!: HTMLVideoElement
    loaded: boolean = false
    io: IntersectionObserver | null = null

    connectedCallback() {
      this.video = this.querySelector('.js-video') as HTMLVideoElement

      this.io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) this.ensureLoaded()
          })
        },
        { rootMargin: '60% 0px' }
      )
      this.io.observe(this)
    }

    disconnectedCallback() {
      this.io?.disconnect()
    }

    /**
     * Assign the real video source only once it is near the viewport.
     */
    ensureLoaded() {
      if (this.loaded) return
      this.loaded = true

      const src = this.video.dataset.src
      if (src) this.video.src = src
    }

    /**
     * Start playback (lazily loading the source first if needed).
     */
    activate() {
      this.ensureLoaded()
      this.video.play().catch(() => {})
    }

    /**
     * Stop playback without discarding the loaded source.
     */
    deactivate() {
      this.video.pause()
    }
  }

  if (!customElements.get('a-work')) {
    customElements.define('a-work', AWork)
  }
</script>

<style lang="scss">
  a-work {
    display: block;

    width: 100%;
    height: 100%;
  }

  .a__video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }
</style>
