---
const { caption, cssClass, index, site, src, total } = Astro.props

// A random string with the syntax '[a-z][0-9]{3}-index-total'
const key = Math.random().toString(36).slice(2, 6) + '-' + index + '/' + total
---

<a-work class={cssClass}>
  <div class="a__inner">
    <a href={site} target="_blank">
      <video
        data-src={src}
        class="a__video js-video"
        loop
        muted
        playsinline
        width="1082"
        height="636"
      >
      </video>

      <div class="a__caption">
        <div class="a__caption__text">
          {caption}
        </div><!-- .a__caption__text -->

        <div class="a__caption__key">
          #{key}
        </div><!-- .a__caption__key -->
      </div><!-- .a__caption -->
    </a>
  </div><!-- .a__inner -->
</a-work>

<script>
  import { gsap } from 'gsap'

  // Shared across every <a-work> instance (45 on this page) — mirrors the
  // `tablet`/`phone` SCSS breakpoints (see _breakpoints.scss) so
  // computeTransform() below picks the same branch the removed
  // .s__scene__work CSS did.
  const mqTablet = window.matchMedia('only screen and (max-width: 987px)')
  const mqPhone = window.matchMedia(
    'only screen and (max-width: 767px) and (orientation: landscape), only screen and (max-width: 576px)'
  )

  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement
    video: HTMLVideoElement

    isPlaying: boolean
    playPromise: Promise<void> | null
    playGeneration: number

    // quickSetter for the transform this element's rule (.s__scene__work,
    // in SWork.astro) used to resolve via var(--progress)/var(--y)/
    // var(--size).
    setTransform: Function

    /**
     * Init
     */
    connectedCallback() {
      // Elements
      this.video = this.querySelector('.js-video')
      this.link = this.querySelector('a')

      // Properties
      this.isPlaying = false
      this.playPromise = null
      this.playGeneration = 0

      this.setTransform = gsap.quickSetter(this, 'transform')

      // Events
      this.link.addEventListener('click', this.onClick.bind(this))
    }

    /**
     * Attribute changed
     */
    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        const progress = parseFloat(newValue)

        this.setTransform(this.computeTransform(progress))

        const isOutOfView = Math.abs(progress) >= 0.98

        if (isOutOfView) {
          if (this.classList.contains('is-inview')) {
            this.outView()
          }
        } else {
          if (!this.classList.contains('is-inview')) {
            this.inView()
          }
        }
      }
    }

    /**
     * Refresh transform
     *
     * Re-applies the transform from the current progress attribute,
     * reading the latest --y/--size values that may have changed on resize.
     */
    refreshTransform() {
      const progress = parseFloat(this.getAttribute('progress')) || 0
      this.setTransform(this.computeTransform(progress))
    }

    /**
     * Compute transform
     *
     * Transcribed from `.s__scene__work`'s transform (SWork.astro), which
     * used to resolve var(--progress)/var(--y)/var(--size) via CSS.
     * --y/--size are still read from this element's own inline style —
     * set once per resize by Section.setWorks() — but that's a plain
     * CSSStyleDeclaration read (this.style), not getComputedStyle(), so
     * it doesn't force a style recalc.
     */
    computeTransform(progress) {
      const y = parseFloat(this.style.getPropertyValue('--y')) || 0
      const size = parseFloat(this.style.getPropertyValue('--size')) || 1

      // transform: rotateY(calc(var(--progress) * -20deg))
      const rotateYDeg = progress * -20
      // translate3d(
      //   calc(var(--progress) * (50vw + 100%) - 50%),
      const translateX = `calc(${progress} * (50vw + 100%) - 50%)`
      //   calc(var(--y) * 50% - 50%),           (default/tablet)
      //   calc(var(--y) * 100% - 50%),          (phone)
      const isPhone = mqPhone.matches
      const translateY = `calc(${y} * ${isPhone ? 100 : 50}% - 50%)`
      //   calc(var(--progress) * var(--progress) * -5rem)
      // )
      const translateZ = `${progress * progress * -5}rem`
      // scale(var(--size));   — default only, dropped under tablet/phone
      const scalePart = isPhone || mqTablet.matches ? '' : ` scale(${size})`

      return `rotateY(${rotateYDeg}deg) translate3d(${translateX}, ${translateY}, ${translateZ})${scalePart}`
    }

    /**
     * Loads the video source if it hasn't been loaded yet.
     *
     * Only the first few works are eagerly loaded by SWork on intersect;
     * the rest load lazily here, the first time they scroll into view.
     */
    loadVideo() {
      if (
        this.video.classList.contains('is-loaded') ||
        this.video.getAttribute('src')
      ) {
        return
      }

      this.video.setAttribute('src', this.video.getAttribute('data-src'))
      this.video.load()

      this.video.addEventListener(
        'canplaythrough',
        () => {
          this.video.classList.add('is-loaded')
        },
        { once: true }
      )
    }

    /**
     * Gets in view
     */
    inView() {
      this.classList.add('is-inview')

      if (!this.video.classList.contains('is-loaded')) {
        this.loadVideo()
      }

      this.playGeneration++

      this.playPromise = this.video.play()

      if (this.playPromise && typeof this.playPromise.then === 'function') {
        this.playPromise
          .then(() => {
            this.isPlaying = true
          })
          .catch(() => {
            // Autoplay blocked, or the play() request was interrupted
            // (e.g. by a pause()) — leave isPlaying false so a later
            // inView() call retries.
            this.isPlaying = false
          })
          .finally(() => {
            this.playPromise = null
          })
      } else {
        this.isPlaying = true
      }
    }

    /**
     * Gets out view
     */
    outView() {
      this.classList.remove('is-inview')

      if (this.playPromise) {
        // Wait for the pending play() to settle before pausing, so we don't
        // interrupt it and trigger an AbortError.
        const generation = this.playGeneration

        this.playPromise
          .catch(() => {})
          .finally(() => {
            // A later inView() may have started a new play() while we were
            // waiting on this one — if so, or if we're back in view, don't
            // pause the newer playback.
            if (
              this.playGeneration !== generation ||
              this.classList.contains('is-inview')
            ) {
              return
            }

            this.video.pause()
            this.isPlaying = false
          })
      } else {
        this.video.pause()
        this.isPlaying = false
      }
    }

    /**
     * On click
     */
    onClick(event: MouseEvent) {
      if (this.link.href.includes('#')) {
        event.preventDefault()
        return false
      }
    }
  }

  customElements.define('a-work', AWork)
</script>

<style lang="scss">
  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(secondary);
    content-visibility: hidden;

    transform-style: preserve-3d;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;

      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .a__video {
      display: block;

      width: auto;
      max-width: 50vw;
      height: auto;
      max-height: 50vh;

      @include mq(phone) {
        max-width: 80vw;
        max-height: 80vh;
      }
    }

    .a__caption {
      @include flex(row, center, space-between);

      padding: 0.5rem 0.5rem;

      color: color(primary);
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-align: right;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }
    }

    &.is-inview {
      content-visibility: visible;

      // Only the video currently attr[progress]-driven by the scrub
      // timeline needs a promoted layer; keep it off for everything
      // outside the viewport-visibility window.
      will-change: transform;
    }
  }
</style>
