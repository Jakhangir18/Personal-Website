---
import AWork from './AWork.astro'
import dummyVideo from '/src/assets/works/Dummy.mp4'

const videos = await Astro.glob<{ default: any }>('/src/assets/works/*.mp4')

// Yeah, this should probably be in a CMS or content file.
// But it’s my site, and editing it in code is faster than setting up yet another headless something.
// Sometimes "quick and dirty" wins. Don’t @ me.
const info = {
  Pen: {
    title: 'CodePen',
    site: 'https://codepen.io/your-username',
  },
  Dummy1: {
    title: 'Dummy Project 1',
    site: 'https://example.com',
  },
  Dummy2: {
    title: 'Dummy Project 2',
    site: 'https://example.com',
  },
  Dummy3: {
    title: 'Dummy Project 3',
    site: 'https://example.com',
  },
  Dummy4: {
    title: 'Dummy Project 4',
    site: 'https://example.com',
  },
  Dummy5: {
    title: 'Dummy Project 5',
    site: 'https://example.com',
  },
  Dummy6: {
    title: 'Dummy Project 6',
    site: 'https://example.com',
  },
  Dummy7: {
    title: 'Dummy Project 7',
    site: 'https://example.com',
  },
  Dummy8: {
    title: 'Dummy Project 8',
    site: 'https://example.com',
  },
  Dummy9: {
    title: 'Dummy Project 9',
    site: 'https://example.com',
  },
  Dummy10: {
    title: 'Dummy Project 10',
    site: 'https://example.com',
  }
}

let projects = []
let pens = []

// I removed the video loops to keep the repo lightweight.
// But this is where I normally fetch and assign the videos for each project in the portfolio.
videos.forEach((video, index) => {
  const src = video.default

  const key = src.split('-')[0].split('/').pop()
  const project = info[key]
  if (!project) return
  const caption = project.title
  const site = project.site

  if (key === 'Pen') {
    pens.push({
      caption,
      site,
      src,
    })
  } else {
    projects.push({
      caption,
      site,
      src,
    })
  }
})

// Create dummy projects with 3 videos each
for (let i = 1; i <= 14; i++) {
  const key = `Dummy${i}`
  const project = info[key]
  if (!project) continue

  for (let j = 0; j < 4; j++) {
    projects.push({
      caption: `${project.title} - Video ${j + 1}`,
      site: project.site,
      src: dummyVideo
    })
  }
}

function shuffle(array) {
  let currentIndex = array.length

  while (currentIndex != 0) {
    let randomIndex = Math.floor(Math.random() * currentIndex)
    currentIndex--
    ;[array[currentIndex], array[randomIndex]] = [
      array[randomIndex],
      array[currentIndex],
    ]
  }
}

shuffle(projects)

// Add pens in between projects regularly
let works = []
let chunkSize = Math.floor(projects.length / pens.length)
let i = 0
let j = 0
while (i < projects.length) {
  works.push(projects[i])
  if (j < pens.length && (i + 1) % chunkSize === 0) {
    works.push(pens[j])
    j++
  }
  i++
}
---

<section id="work" class="s-work" data-intersect>
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">W</span>
          <span class="s__title__letter js-letter">O</span>
          <span class="s__title__letter js-letter">R</span>
          <span class="s__title__letter js-letter">K</span>
        </span>
      </h2>

      <div class="s__scene js-scene">
        {
          works.map((work, index) => (
            <AWork
              cssClass="s__scene__work s__scene__work--video js-work"
              caption={work.caption}
              site={work.site}
              src={work.src}
              index={String(index).padStart(4, '0')}
              total={String(works.length).padStart(2, '0')}
            />
          ))
        }
      </div><!-- .s__scene -->

      <canvas class="s__canvas js-canvas"></canvas>
    </div><!-- .s__inner -->

    <div class="s__mask-outer">
      <div class="s__mask js-mask">
        <svg class="s__mask__svg js-mask-svg">
          <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
          <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
          <path class="s__mask__path-lines js-mask-path-lines" d=""></path>
        </svg>
      </div><!-- .s__mask -->
    </div><!-- .s__mask-outer -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'
  import { SlowMo } from 'gsap/EasePack'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger, SlowMo)

  class Section {
    static EAGER_LOAD_LIMIT = 6

    el: HTMLElement
    container: HTMLElement
    ruler: HTMLElement
    scene: HTMLElement
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D
    staticCanvas: HTMLCanvasElement
    staticCtx: CanvasRenderingContext2D
    title: HTMLElement
    videos: NodeListOf<HTMLVideoElement>

    mask: {
      width: number
      height: number
      maxScale: number
      lines: any[]
      el: HTMLElement
      svg: HTMLElement
      pathOuter: HTMLElement
      pathInner: HTMLElement
      pathLines: HTMLElement
    }

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    letters: any[]
    works: any[]
    points: any[]
    pointsGap: number
    pointColor: string

    tl: gsap.core.Timeline
    animationProgress: number
    pointsProgress: number
    last: {
      animationProgress: number
      pointsProgress: number
      scrollProgress: number
    }
    scrollProgress: number
    state: 0
    speed: number
    isPaused: boolean
    loadIsStarted: boolean
    eagerLoadCount: number

    // Media query mirroring the `phone` SCSS breakpoint, used so the JS
    // transforms below match the CSS phone override (transform: none)
    // instead of always emitting the desktop calc().
    mqPhone: MediaQueryList
    // quickSetter()s for the elements that used to read --scroll-progress
    // via CSS var() — see applyScrollProgress().
    setPathInnerTransform: Function
    setContainerTransform: Function
    setCanvasTransform: Function

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-work')
      this.container = this.el.querySelector('.js-container')
      this.ruler = this.el.querySelector('.js-ruler')
      this.scene = this.container.querySelector('.js-scene')
      this.canvas = this.container.querySelector('.js-canvas')
      this.ctx = this.canvas.getContext('2d')
      // Nearest-neighbor sampling on drawImage() so the pre-rendered dot
      // field (below) isn't softened by bilinear resampling when it's
      // blitted at a fractional-pixel flow offset.
      this.ctx.imageSmoothingEnabled = false
      // Offscreen buffer holding the point grid pre-rendered at rest
      // (pointsProgress === 1, no flow offset). Most of the scroll spends
      // pointsProgress at 1, so the steady-state per-frame cost becomes a
      // single drawImage() instead of re-issuing every point's rect().
      this.staticCanvas = document.createElement('canvas')
      this.staticCtx = this.staticCanvas.getContext('2d')
      this.title = this.container.querySelector('.js-title')
      this.videos = this.container.querySelectorAll('video')

      // Properties
      this.mask = {
        width: 0,
        height: 0,
        maxScale: 1,
        lines: [],
        el: this.el.querySelector('.js-mask'),
        svg: this.el.querySelector('.js-mask-svg'),
        pathOuter: this.el.querySelector('.js-mask-path-outer'),
        pathInner: this.el.querySelector('.js-mask-path-inner'),
        pathLines: this.el.querySelector('.js-mask-path-lines'),
      }

      // Same media query as the `phone` SCSS breakpoint (see
      // _breakpoints.scss) — checked instead of hardcoding a width so
      // applyScrollProgress() picks the same branch CSS would have.
      this.mqPhone = window.matchMedia(
        'only screen and (max-width: 767px) and (orientation: landscape), only screen and (max-width: 576px)'
      )

      // These elements' transforms used to read --scroll-progress via
      // CSS var(), which is inherited from `.s-work` and so invalidated
      // the style of every descendant on every tick(). Writing the
      // resolved transform string directly onto just these three
      // elements instead invalidates only them.
      this.setPathInnerTransform = gsap.quickSetter(
        this.mask.pathInner,
        'transform'
      )
      this.setContainerTransform = gsap.quickSetter(
        this.container,
        'transform'
      )
      this.setCanvasTransform = gsap.quickSetter(this.canvas, 'transform')

      this.letters = []
      this.title.querySelectorAll('.js-letter').forEach((_letter) => {
        const letter = {
          el: _letter,
          ghosts: [],
        }

        this.letters.push(letter)
      })

      this.works = []
      this.container.querySelectorAll('.js-work').forEach((_work) => {
        const work = {
          el: _work,
        }

        this.works.push(work)
      })

      this.points = []

      this.scrollProgress = 0
      this.last = {
        animationProgress: 0,
        pointsProgress: 0,
        scrollProgress: 0,
      }

      this.isPaused = true
      this.loadIsStarted = false
      this.eagerLoadCount = 0

      // Init
      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    /**
     * Init
     */
    init() {
      // Register the cheap listeners right away — in particular the
      // 'intersect' listener, since index.astro's IntersectionObserver
      // can deliver its initial notification for this section before a
      // deferred bindEvents() would have attached it, permanently
      // missing the load-videos/start-ticking kickoff for a section
      // that's already in the viewport on load.
      this.bindEvents()

      // setPoints()/setLetters() build the canvas point grid and ghost
      // letters — not needed for first paint since this section is
      // below the fold. Defer to idle time (with a timeout fallback) so
      // this heavy synchronous work doesn't compete with the hero's
      // paint/intro on the main thread. tick() guards on this.tl so it
      // no-ops if it runs (via the 'tick' listener from onIntersect)
      // before this finishes.
      const run = () => {
        this.setCtxStyle()
        this.setSize()
        this.setMask()
        this.setPoints()
        this.setLetters()
        this.setWorks()
        this.setTimeline()

        // Match the initial state the removed CSS var()-based transforms
        // used to render, before the first tick() runs.
        this.applyScrollProgress(this.scrollProgress)

        // The heavy state onIntersect/tick depend on now exists.
        // Replay the current intersection state in case it was
        // already delivered (and handled as a no-op) while this setup
        // was pending, so a section already in view starts as normal.
        this.onIntersect({
          detail: { isIntersecting: this.el.classList.contains('is-in-view') },
        })
      }

      if ('requestIdleCallback' in window) {
        ;(window as any).requestIdleCallback(run, { timeout: 2000 })
      } else {
        setTimeout(run, 200)
      }
    }

    /**
     * Bind events
     */
    bindEvents() {
      Emitter.on('contrastchange', this.setCtxStyle, this)
      Emitter.on('resize', this.onResize, this)

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    /**
     * Resize handler
     */
    onResize(widthChanged) {
      if (widthChanged) {
        this.setCtxStyle()
        this.setSize()
        this.setMask()
        this.setPoints()
        this.setLetters()
        this.setWorks()
        this.setTimeline()

        // The phone/desktop branch in applyScrollProgress() depends on
        // viewport width — re-apply so a breakpoint crossing takes effect
        // immediately instead of waiting for the next scroll tick.
        this.applyScrollProgress(this.scrollProgress)
      }
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      // Only the elements the scrub timeline actually touches every frame
      // need a promoted compositor layer — gate `will-change` on this class
      // instead of declaring it permanently (see .is-active in the styles
      // below), so idle/offscreen instances of the section don't force
      // WebKit to keep retina backing stores allocated for ~130 elements.
      this.el.classList.toggle('is-active', !this.isPaused)

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }

      if (!this.loadIsStarted) {
        this.loadNextVideo()
        this.loadIsStarted = true
      }
    }

    /**
     * Set canvas style
     */
    setCtxStyle() {
      const color = getComputedStyle(this.el).getPropertyValue(
        '--color-primary'
      )

      // Stored so renderStaticPoints() can re-apply it after resizing the
      // offscreen canvas, which resets all 2D context state (see below).
      this.pointColor = color

      Ticker.nextTick(() => {
        this.ctx.fillStyle = color
        this.renderStaticPoints()
      })
    }

    /**
     * Set size
     */
    setSize() {
      this.el.style.setProperty('--height', this.works.length * 50 + 'lvh')

      const bounding = this.container.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: window.safeWidth,
        height: window.safeHeight,
      }

      this.canvas.width = this.bounding.width
      this.canvas.height = this.bounding.height

      this.speed = Math.hypot(this.bounding.width, this.bounding.height) * 4
    }

    /**
     * Set mask
     */
    setMask() {
      const { mask } = this

      const width = mask.el.clientWidth
      const height = mask.el.clientHeight

      mask.width = width
      mask.height = height

      mask.svg.style.width = mask.width + 'px'
      mask.svg.style.height = mask.height + 'px'

      const elBounding = this.el.getBoundingClientRect()
      const rulerBounding = this.ruler.getBoundingClientRect()
      const rulerWidth = rulerBounding.width
      const rulerHeight = rulerBounding.height
      const offsetX = rulerBounding.left - elBounding.left
      const offsetY = rulerBounding.top - elBounding.top

      // Shape
      const dOuter = `M -1 0 L ${width + 2} 0 L ${width + 2} ${height} L -1 ${height} Z`

      // Mask outer
      const corners = {
        tl: { x: offsetX, y: offsetY },
        tr: { x: offsetX + rulerWidth, y: offsetY },
        br: { x: offsetX + rulerWidth, y: offsetY + rulerHeight },
        bl: { x: offsetX, y: offsetY + rulerHeight },
      }

      let size = (corners.tr.x - corners.tl.x) / 2

      mask.maxScale = window.safeWidth / size

      let dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`
      const linesClip = `${dOuter} ${dInner}`

      mask.pathOuter.setAttribute('d', `${dOuter} ${dInner}`)

      // Mask inner
      const thickness = window.safeWidth > 767 ? 16 : 8
      corners.tl.x += thickness
      corners.tl.y += thickness

      corners.tr.x -= thickness
      corners.tr.y += thickness

      corners.br.x -= thickness
      corners.br.y -= thickness

      corners.bl.x += thickness
      corners.bl.y -= thickness

      size = (corners.tr.x - corners.tl.x) / 2

      dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`

      mask.pathInner.setAttribute('d', `${dOuter} ${dInner}`)

      // Lines
      mask.lines = []

      const vLines = window.safeWidth > 767 ? 12 : 8
      const gapX = width / vLines
      const gapY = height * 0.1
      const hLines = Math.ceil(height / gapY)

      for (let i = 1; i < vLines; i++) {
        const x = gapX * i

        mask.lines.push({
          p1: { x, y: 0 },
          p2: { x, y: height },
        })
      }

      for (let i = 0; i < hLines; i++) {
        const y = gapY * i

        mask.lines.push({
          p1: { x: 0, y },
          p2: { x: width, y },
        })
      }

      let dLines = ''

      mask.lines.forEach((line) => {
        dLines += `M ${line.p1.x} ${line.p1.y} L ${line.p2.x} ${line.p2.y} `
      })

      mask.pathLines.setAttribute('d', dLines)
      mask.pathLines.style.clipPath = `path(evenodd, '${linesClip}')`
    }

    /**
     * Set letters
     */
    setLetters() {
      const { letters, scene } = this

      letters.forEach((letter, j) => {
        letter.ghosts.forEach((ghost) => {
          ghost.el.remove()
        })
        letter.ghosts = []

        // Get letter position and size
        const bounding = letter.el.getBoundingClientRect()

        letter.width = bounding.width
        letter.height = bounding.height
        letter.top = bounding.top - this.bounding.top
        letter.left = bounding.left

        letter.freq = 1 + Math.random()

        const multiplier = window.safeWidth > 767 ? 0.75 : 0.5

        // Create ghost letters
        letter.total =
          Math.round((this.bounding.width / letter.width) * multiplier) + 2

        for (let i = 0; i < letter.total; i++) {
          const el = document.createElement('span')
          el.classList.add('s__scene__letter')
          el.classList.add('js-letter')

          el.innerText = letter.el.innerText
          el.dataset.letter = letter.el.innerText

          scene.appendChild(el)

          const iy = ((j + 1) / (letters.length + 1) - 0.5) * 2

          const ghost = {
            el,
            x: letter.left,
            y: letter.top,
            z: Math.random() * 100,
            i: i - letter.total * 0.5,
            iy,
            p: (i / letter.total - 0.5) * 2,
            ap: Math.abs(i / letter.total - 0.5) * 2,
            mx: 0,
            my: 0,
            // Cached by applyGhostTransform()/moveLetters() so the
            // transform can be recomputed from whichever one of
            // {--state, --progress} changed without re-deriving both.
            progress: 0.5,
            // quickSetter for the transform this ghost's rule used to
            // resolve via var(--head)/var(--state) — see
            // Section.applyGhostTransform().
            setTransform: gsap.quickSetter(el, 'transform'),
          }

          el.style.top = ghost.y + 'px'
          el.style.left = ghost.x + 'px'

          el.style.zIndex = String(j !== 1 && j !== 2 && (j + letters.length + i) % 5 === 0 ? 3 : 1)

          el.style.setProperty('--ix', String(ghost.i))
          el.style.setProperty('--iy', String(iy))

          el.style.setProperty('--ap', String(ghost.ap))
          el.style.setProperty('--p', String(ghost.p))

          // --progress still has to be written per-ghost: it feeds
          // --head/--ahead, which the ::before shadow's opacity/transform/
          // transform-origin (a pseudo-element — unreachable from JS) read
          // via CSS var(). Written here so the shadow's initial paint
          // matches the transform set by applyGhostTransform() below.
          el.style.setProperty('--progress', String(ghost.progress))

          letter.ghosts.push(ghost)

          // Match the initial transform to this.state (0 before the
          // section has scrolled) instead of leaving it unset.
          this.applyGhostTransform(ghost)
        }
      })
    }

    /**
     * Set works
     */
    setWorks() {
      const { works } = this

      works.forEach((work, i) => {
        const el = work.el

        el.style.setProperty('--size', String(0.5 + Math.random() * 0.5))
        el.style.setProperty(
          '--y',
          String((0.5 + Math.random() * 0.5) * (i % 2 ? -1 : 1))
        )
      })
    }

    /**
     * Set timeline
     */
    setTimeline() {
      const { el, container, works, scene, mask } = this

      const worksEl = works.map((work) => work.el)

      let { tl } = this

      if (tl) {
        if (tl.scrollTrigger) {
          tl.scrollTrigger.kill()
        }
        tl.kill()
      }

      tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top 25%',
          end: 'bottom 75%',
          scrub: 1,
        },
        onUpdate: () => {
          this.updateSceneState()
        },
      })

      tl.fromTo(
        mask.el,
        {
          scale: 1,
        },
        {
          scale: mask.maxScale,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        scene,
        {
          scale: 0.75,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      // NOTE: left as an animated clip-path rather than swapped for a
      // transform-based reveal. `container` (.s__inner) already gets its
      // own transform written every tick() by applyScrollProgress()
      // (via a quickSetter). GSAP's transform-related tweens (x/y/scale/
      // etc.) write the whole inline `transform` shorthand from their own
      // internal state, which would silently clobber that scroll-linked
      // translate for as long as this element has ever been tweened —
      // breaking the scroll-linked vertical motion. Left as clip-path.
      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 1rem)',
        },
        {
          clipPath: 'inset(0 0rem)',
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      tl.fromTo(
        this,
        {
          pointsProgress: 0,
        },
        {
          pointsProgress: 1,
          duration: 1,
          ease: 'power4.inOut',
        },
        0
      )

      tl.fromTo(
        this,
        {
          state: 0,
        },
        {
          state: 1,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        worksEl,
        {
          attr: {
            progress: 1,
          },
        },
        {
          attr: {
            progress: -1,
          },
          ease: 'slow(0.15, 0.6)',
          stagger: 0.25,
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          animationProgress: 0,
        },
        {
          animationProgress: 10000,
          duration: tl.totalDuration(),
          ease: 'power1.out',
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          state: 1,
        },
        {
          state: 0,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        mask.el,
        {
          scale: mask.maxScale,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        scene,
        {
          scale: 1,
        },
        {
          scale: 0.75,
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 0rem)',
        },
        {
          clipPath: 'inset(0 1rem)',
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        this,
        {
          pointsProgress: 1,
        },
        {
          pointsProgress: 0,
          duration: 1,
          ease: 'power4.inOut',
        },
        '-=1'
      )

      this.tl = tl
    }

    /**
     * Load next video
     *
     * Only eagerly chains through the first EAGER_LOAD_LIMIT works on
     * intersect; the rest are loaded on demand by AWork.inView() so we don't
     * force every video's .load() on first scroll into the section.
     */
    loadNextVideo() {
      if (this.eagerLoadCount >= Section.EAGER_LOAD_LIMIT) return

      const video = Array.from(this.videos).find(
        (video) =>
          !video.classList.contains('is-loaded') && !video.getAttribute('src')
      )

      if (video) {
        if (video.readyState >= 3) {
          this.videoLoaded(video)
        } else {
          video.addEventListener(
            'canplaythrough',
            () => {
              this.videoLoaded(video)
            },
            { once: true }
          )

          video.setAttribute('src', video.getAttribute('data-src'))
          video.load()
        }
      }
    }

    /**
     * Video loaded
     */
    videoLoaded(video) {
      video.classList.add('is-loaded')
      this.eagerLoadCount++
      this.loadNextVideo()
    }

    /**
     * Move letters
     */
    moveLetters() {
      const { speed, letters, animationProgress, last } = this

      const rAnimationProgress = Math.round(animationProgress * 100) / 100

      if (rAnimationProgress === last.animationProgress) return

      letters.forEach((letter, i) => {
        const letterSpeed = speed * letter.freq
        letter.ghosts.forEach((ghost, index) => {
          let progress =
            (((animationProgress % letterSpeed) / letterSpeed +
              index / letter.total) %
              1) /
              0.7 -
            0.15

          ghost.progress = progress

          // Still required: feeds --head/--ahead, read by the ::before
          // shadow (opacity/transform/transform-origin) — a pseudo-element
          // has no DOM node a quickSetter can target, so this custom
          // property write can't be replaced with an inline style. It's
          // already scoped to this one ghost span though (not a root), so
          // it only invalidates this span + its own ::before.
          ghost.el.style.setProperty('--progress', String(progress))

          this.applyGhostTransform(ghost)
        })
      })
    }

    /**
     * Apply ghost letter transform
     *
     * Transcribed from `.s__scene__letter`'s (non-::before) transform,
     * which used to resolve var(--head)/var(--state)/var(--iy) via CSS.
     * Called whenever either input changes: from moveLetters() (progress)
     * and from the timeline's onUpdate (state) — see setTimeline().
     */
    applyGhostTransform(ghost) {
      const { state } = this
      const progress = ghost.progress

      // --head: calc((var(--progress) - 0.5) * -2);
      const head = (progress - 0.5) * -2
      // --ahead: calc(var(--head) * var(--head));
      const ahead = head * head

      // transform: rotateY(calc(var(--head) * -10deg * var(--state)))
      //   translate3d(
      //     calc(var(--head) * 50vw * var(--state)),
      //     calc(var(--iy) * 50% * var(--ahead) * var(--state)),
      //     0
      //   );
      const rotateYDeg = head * -10 * state
      const translateXvw = head * 50 * state
      const translateYpct = ghost.iy * 50 * ahead * state

      ghost.setTransform(
        `rotateY(${rotateYDeg}deg) translate3d(${translateXvw}vw, ${translateYpct}%, 0)`
      )
    }

    /**
     * Update scene state
     *
     * --state used to be written once on `.s__scene` — an ancestor of
     * every ghost letter *and* all 45 <a-work> elements — so every write
     * invalidated the style of that entire subtree. Its only consumers
     * are the ghost letters (.s__scene__letter's transform and its
     * ::before shadow), so the write is scoped down to just the ghost
     * spans instead. --state itself still has to stay a custom property
     * (rather than move fully into applyGhostTransform()'s inline
     * transform) because the ::before shadow's opacity/transform/
     * transform-origin read it via var() and a pseudo-element has no DOM
     * node a quickSetter can target.
     */
    updateSceneState() {
      const { letters, state } = this

      letters.forEach((letter) => {
        letter.ghosts.forEach((ghost) => {
          ghost.el.style.setProperty('--state', String(state))
          this.applyGhostTransform(ghost)
        })
      })
    }

    /**
     * Set points
     */
    setPoints() {
      const { bounding } = this

      this.points = []

      // Was 24 (≈5184 points on a 1920x1080 viewport, redrawn every
      // frame via individual ctx.rect() calls). 36 cuts that to ≈2300
      // points, and the steady-state (pointsProgress === 1) frame cost is
      // now a single drawImage() from the pre-rendered static field
      // below, regardless of point count.
      const gap = 36
      this.pointsGap = gap

      const cols = Math.ceil((bounding.width * 1.2) / gap)
      const rows = Math.ceil((bounding.height * 1.2) / gap)

      const offsetX = (bounding.width - cols * gap) * 0.5
      const offsetY = (bounding.height - rows * gap) * 0.5

      const hWidth = bounding.width * 0.5
      const hHeight = bounding.height * 0.5

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * gap + offsetX
          const y = j * gap + offsetY

          const dx = hWidth - x
          const dy = hHeight - y

          this.points.push({
            x,
            y,
            dx,
            dy,
            m: Math.random(),
            flowX: 0,
          })
        }
      }

      this.renderStaticPoints()
    }

    /**
     * Render the static dot field (pointsProgress === 1, no flow offset)
     * into the offscreen canvas once, instead of every frame.
     */
    renderStaticPoints() {
      const { bounding, points, pointsGap, staticCanvas, staticCtx } = this

      if (!staticCtx || !points.length) return

      // Pad the buffer by one pointsGap on every side so the point field
      // (drawn with the same ~10% overscan setPoints() uses) fully covers
      // the region drawPoints() blits from, even at the largest flow
      // offset — otherwise the trailing edge goes blank after a shift.
      const padding = pointsGap

      staticCanvas.width = bounding.width + padding * 2
      staticCanvas.height = bounding.height + padding * 2

      // Assigning canvas width/height above resets all 2D context state
      // (including fillStyle), so it must be (re-)applied after, not
      // before, or the pre-rendered dots always paint black.
      staticCtx.fillStyle = this.pointColor

      staticCtx.clearRect(0, 0, staticCanvas.width, staticCanvas.height)

      staticCtx.beginPath()

      points.forEach((point) => {
        staticCtx.rect(point.x + padding, point.y + padding, 0.5, 0.5)
      })

      staticCtx.fill()
    }

    /**
     * Move points
     */
    movePoints() {
      const { points, pointsGap, animationProgress, last } = this

      const rAnimationProgress = Math.round(animationProgress * 100) / 100

      if (rAnimationProgress === last.animationProgress) return

      const flowX = (animationProgress * -0.05) % pointsGap

      points.forEach((p) => {
        // Flow
        p.flowX = flowX
      })
    }

    /**
     * Draw points
     */
    drawPoints() {
      const {
        bounding,
        ctx,
        points,
        pointsGap,
        staticCanvas,
        animationProgress,
        pointsProgress,
        last,
      } = this

      const rAnimationProgress = Math.round(animationProgress * 100) / 100
      const rPointsProgress = Math.round(pointsProgress * 100) / 100

      if (
        rPointsProgress === last.pointsProgress &&
        rAnimationProgress === last.animationProgress
      )
        return

      ctx.clearRect(0, 0, bounding.width, bounding.height)

      if (rPointsProgress >= 1) {
        // Steady state (the vast majority of the scroll range): blit the
        // pre-rendered dot field, translated by the current flow offset,
        // instead of re-issuing a rect() per point every frame.
        const flowX = points.length ? points[0].flowX : 0
        // Undo the padding renderStaticPoints() baked into the buffer so
        // the field lines back up with the per-point path's coordinates.
        const padding = pointsGap

        ctx.drawImage(staticCanvas, flowX - padding, -padding)
      } else {
        // Mid entrance/exit transition: points are pulled toward/away
        // from the center by pointsProgress, which the static field
        // doesn't capture — fall back to the original per-point draw.
        ctx.beginPath()

        points.forEach((point) => {
          const x =
            point.x + point.dx * (1 - pointsProgress) * 0.2 + point.flowX
          const y = point.y + point.dy * (1 - pointsProgress) * 0.2

          ctx.rect(x, y, 0.5, 0.5)
        })

        ctx.fill()
      }

      last.pointsProgress = rPointsProgress
      last.animationProgress = rAnimationProgress
    }

    /**
     * Tick
     */
    tick() {
      // The deferred heavy setup (setPoints/setLetters/setMask/setWorks/
      // setTimeline) may not have run yet if onIntersect's 'tick'
      // subscription fires early — bail until it has, since movePoints/
      // moveLetters/drawPoints all rely on that state.
      if (!this.tl) return

      const { last } = this

      // Calculate scroll progress
      const scrollProgress =
        Math.max(
          Math.min(1, ScrollTrigger.positionInViewport(this.el, 'top')),
          0
        ) *
          -1 +
        (1 -
          Math.max(
            Math.min(1, ScrollTrigger.positionInViewport(this.el, 'bottom')),
            0
          ))

      const rScrollProgress = Math.round(scrollProgress * 10000) / 10000

      this.scrollProgress = scrollProgress

      if (rScrollProgress !== last.scrollProgress) {
        last.scrollProgress = rScrollProgress

        this.applyScrollProgress(this.scrollProgress)
      }

      // Movement
      this.movePoints()
      this.moveLetters()

      // Draw
      this.drawPoints()
    }

    /**
     * Apply scroll progress
     *
     * Transcribed from the CSS this used to drive via the --scroll-progress
     * custom property (inherited from `.s-work`, so every write invalidated
     * the style of the whole section's subtree). Writing the resolved
     * transform string directly to each of the three consuming elements
     * instead invalidates only those elements.
     */
    applyScrollProgress(scrollProgress) {
      // .s__mask__path-inner: transform: translate3d(0, calc(var(--scroll-progress) * 48px), 0);
      this.setPathInnerTransform(
        `translate3d(0, ${scrollProgress * 48}px, 0)`
      )

      // .s__inner and .s__canvas both had `transform: none;` under
      // @include mq(phone) — mirrored here via matchMedia().
      if (this.mqPhone.matches) {
        this.setContainerTransform('none')
        this.setCanvasTransform('none')
      } else {
        // .s__inner: transform: translate3d(0, calc(var(--scroll-progress) * -15%), 0);
        this.setContainerTransform(
          `translate3d(0, ${scrollProgress * -15}%, 0)`
        )
        // .s__canvas: transform: translate3d(0, calc(var(--scroll-progress) * -5%), 0);
        this.setCanvasTransform(
          `translate3d(0, ${scrollProgress * -5}%, 0)`
        )
      }
    }
  }

  new Section()
</script>

